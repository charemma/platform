set fallback := true

_default:
    @just --list

# install Python dependencies into .venv
bootstrap:
    uv sync

# lint and check formatting
lint:
    uv run ruff check .
    uv run ruff format --check .

# format code
fmt:
    uv run ruff format .

# preview Pulumi changes (dry-run)
preview:
    pulumi preview --stack prod

# deploy groups, runner registration and runner secret
deploy:
    pulumi up --yes --stack prod

# deploy interactively (with confirmation prompt)
up:
    pulumi up --stack prod

# one-time: adopt the UI-created top-level group into the stack
import-org:
    pulumi import --stack prod --protect --yes gitlab:index/group:Group charemma-org "$(pulumi config get orgGroupId --stack prod)"
